# ============================================================
# 🐾 PATITAS SOS — Variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# En producción, inyéctalas como variables del sistema / docker-compose.
# ============================================================

# ---------- Supabase ----------
# URL pública de tu proyecto (Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave anónima (solo lectura pública; se puede exponer en el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Llave maestra de servicio (¡NUNCA exponer en el frontend!
# Se usa ÚNICAMENTE en las API Routes del backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- AWS Rekognition ----------
# Credenciales IAM con permisos de Rekognition (ver supabase/aws-iam-policy.json)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Región donde creaste la colección (ej: us-east-1)
AWS_REGION=us-east-1
# Nombre de la colección de caras (crear con:
#   aws rekognition create-collection --collection-id perritos --region us-east-1)
AWS_REKOGNITION_COLLECTION_ID=perritos

# ---------- Notificaciones por correo (Resend) ----------
# API key de https://resend.com (plan gratuito: 3000 emails/mes)
RESEND_API_KEY=re_...
# Remitente verificado en Resend (debe estar verificado en tu dominio)
EMAIL_FROM=Patitas SOS <no-reply@tudominio.co>
# URL pública de la app para los enlaces de los correos (ej: https://patitas.tudominio.co)
APP_URL=http://localhost:3000
# Secreto para firmar el enlace "marcar como encontrada" (genera uno con: openssl rand -hex 32)
APP_TOKEN_SECRET=cambia-por-un-secreto-largo-y-aleatorio
