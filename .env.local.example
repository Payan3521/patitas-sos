# ============================================================
# 🐾 PATITAS SOS — Variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# En producción, inyéctalas como variables del sistema / docker-compose.
# ============================================================

# ---------- Supabase (base de datos + storage) ----------
# El LOGIN es propio (email + contraseña, ver migración 004): Supabase Auth
# ya no se usa. La app escribe siempre desde las API Routes con esta llave.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública del navegador (Settings → API → anon/public).
# SOLO se usa para el chat en tiempo real (canales de broadcast): ningún
# dato del chat viaja por aquí, los mensajes siempre por API con sesión.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Llave maestra de servicio (¡NUNCA exponer en el frontend!
# Se usa ÚNICAMENTE en las API Routes del backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------- IA: Gemini (Interactions API, reemplazó a AWS Rekognition) ----------
# API key de Google AI Studio: https://aistudio.google.com/apikey
# ⚠️ El modo "match de una" (compara todos los candidatos, hasta 300) requiere un
# proyecto CON BILLING: el free tier limita a ~5 llamadas/min y a una cuota diaria.
# Costo realista con 3.5 Flash: ~US$0,24/publicación con ~100 candidatos
# (detalles y escenarios en docs/costos.md; guía de despliegue en docs/DEPLOY.md).
GEMINI_API_KEY=AIza...
# Modelo por defecto. Con llaves nuevas los 2.x ya no existen: usa un 3.x.
# gemini-3.5-flash: mejor equilibrio calidad/precio (default de la app).
# gemini-3.1-flash-lite: el más barato (docs/costos.md).
GEMINI_MODEL=gemini-3.5-flash

# ---------- Correos de coincidencias (Brevo — gratis 300/día) ----------
# 1) Cuenta gratis en https://brevo.com (sin tarjeta)
# 2) SMTP & API → API Keys → Generate a new API key (xkeysib-...)
# 3) SMTP & API → Senders → Add a sender → verifica tu email por clic
MAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
# Debe coincidir EXACTAMENTE con el remitente verificado en Brevo
BREVO_FROM=Patitas SOS <tu-correo-verificado@gmail.com>
# (Alternativa: resend — requiere dominio verificado
#   MAIL_PROVIDER=resend
#   RESEND_API_KEY=re_...
#   EMAIL_FROM=Patitas SOS <no-reply@tudominio.co>)

# ---------- Revisión diaria automática (cron) ----------
# Secreto que protege POST /api/revisar-coincidencias (genera uno con:
#   openssl rand -hex 32
# Pégalo también en la programación de pg_cron (ver migración 005).
CRON_SECRET=cambia-por-un-secreto-largo-y-aleatorio

# URL pública de la app para los enlaces de los correos (ej: https://patitas.tudominio.co)
APP_URL=http://localhost:3000
# Secreto para firmar sesiones (login propio) y el enlace "marcar como
# encontrada" (genera uno con: openssl rand -hex 32)
APP_TOKEN_SECRET=cambia-por-un-secreto-largo-y-aleatorio